# Environment Variables — NEVER commit the real .env
.env
.env.*
!.env.example

# Virtual Environment (uv / venv)
.venv/
venv/
env/

# Python Bytecode
__pycache__/
*.py[cod]
*.pyo

# Testing & Linting caches
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# Vector Database — local on-disk ChromaDB storage
# Re-generated by running: uv run python -c "from rag.ingest import build_index; build_index()"
chroma_db/

# uv lock (keep pyproject.toml but you may choose to gitignore the lock)
# uv.lock  ← kept tracked (reproducible builds)
