# Copy this file to .env and fill in your own values.
# NEVER commit .env — it is in .gitignore.

# ─── OpenAI ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Upstash Redis (for rate-limiting + exact-match cache) ──────────────────
# Get these from https://console.upstash.com → your database → REST API
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# ─── CORS (set to your deployed frontend URL in production) ──────────────────
# Defaults to http://localhost:5173 if not set.
FRONTEND_URL=https://your-portfolio-domain.com
